{
  "name": "cross-team-management",
  "version": "1.5.1",
  "private": true,
  "description": "跨团队管理：上下文管理在周报场景的落地——过滤团队周报流水账，按进展/卡点/计划组装成红黄绿灯上下文，自动注入模型，并支持催办升级与邮件草稿。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "domain.mjs",
    "client.js",
    "cordis.patch.yml",
    "config.example.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "license": "MIT"
}